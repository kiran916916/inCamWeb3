# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://incam:change-me-in-production@localhost:5432/incam_platform

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-in-production

# ─── Auth Service ─────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 4096 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
COOKIE_SECRET=change-me-in-production-32-chars-min
ALLOWED_ORIGINS=http://localhost:3000

# ─── Frontend (public — safe to expose) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_POLYGON_RPC=https://rpc-amoy.polygon.technology

# ─── Blockchain ───────────────────────────────────────────────────────────────
RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002

# Contract addresses (filled after deployment)
PLATFORM_TOKEN_CONTRACT=
CONTENT_NFT_CONTRACT=
EDITION_NFT_CONTRACT=
BADGE_NFT_CONTRACT=
MARKETPLACE_CONTRACT=
REWARD_DISTRIBUTOR_CONTRACT=
CREATOR_PASS_CONTRACT=

# Service wallet (NEVER commit actual private keys)
MINTER_PRIVATE_KEY=

# ─── Cloudflare R2 Storage ────────────────────────────────────────────────────
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=incam-media

# ─── IPFS / Pinata ────────────────────────────────────────────────────────────
PINATA_API_KEY=
PINATA_SECRET_KEY=

# ─── Stripe (fiat on-ramp) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Hardhat (local development only) ────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=
POLYGONSCAN_API_KEY=
